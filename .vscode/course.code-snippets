{
	"New Marp Slide": {
		"prefix": "marp-slide",
		"body": [
			"<!-- --- -->",
			"",
			"## ${1:Slide Title}",
			"",
			"${2:Slide content...}",
			"",
			"<!-- Presenter Notes:",
			"$0",
			"-->"
		],
		"description": "Creates a new standard Marp slide structure with title and presenter notes."
	},
	"Generic Callout Box": {
		"prefix": "marp-callout",
		"body": [
			"> **${1:TYPE}:** ${0:Content...}"
		],
		"description": "Inserts a generic callout box structure (e.g., Tip, Warning, Important)."
	},
	"Learning Path Callout Box": {
		"prefix": "marp-callout-path",
		"body": [
			"> **${1|Instructor-Led,Self-Led,Async|}:** ${0:Content...}"
		],
		"description": "Inserts a learning path specific callout box."
	},
	"Experience Tie-in Callout Box": {
		"prefix": "marp-callout-exp",
		"body": [
			"> **${1|Native Android Developers,Native iOS Developers,React Web Developers,Angular Web Developers|}:** ${0:Content...}"
		],
		"description": "Inserts an experience tie-in callout box."
	},
	"Inline Code Example Slide": {
		"prefix": "marp-code-inline",
		"body": [
			"<!-- --- -->",
			"",
			"## ${1:Code Example Title}",
			"",
			"${2:Brief introductory sentence.}",
			"",
			"```${3|tsx,jsx,typescript,javascript,css,html,json,yaml,bash|}",
			"$4",
			"```",
			"",
			"<!-- Presenter Notes:",
			"**Purpose:** [Explain the goal of this code snippet]",
			"**Logic:** [Describe the flow and key logic]",
			"**Key APIs/Concepts:**",
			"- `[API/Concept 1]`: [Explanation]",
			"- `[API/Concept 2]`: [Explanation]",
			"",
			"[Provide detailed explanation, aiming for 200+ words if code > 5 lines]",
			"$0",
			"-->"
		],
		"description": "Creates a slide structure for inline code examples (<= 25 lines)."
	},
	"Embedded Code Example Slide (Snack/Sandbox)": {
		"prefix": "marp-code-embed",
		"body": [
			"<!-- --- -->",
			"",
			"## ${1:Embedded Example Title}",
			"",
			"${2:Brief introductory sentence linking to the embedded example below.}",
			"",
			"<iframe src=\"${3:Paste Snack/Sandbox Embed URL here}\"",
			"    style=\"width:100%; height:500px; border:0; border-radius: 4px; overflow:hidden;\"",
			"    title=\"${1:Embedded Example Title}\"",
			"    allow=\"accelerometer; ambient-light-sensor; camera; encrypted-media; geolocation; gyroscope; hid; microphone; midi; payment; usb; vr; xr-spatial-tracking\"",
			"    sandbox=\"allow-forms allow-modals allow-popups allow-presentation allow-same-origin allow-scripts\">",
			"</iframe>",
			"",
			"<!-- Presenter Notes:",
			"**Purpose:** [Explain the goal of the embedded example]",
			"**Logic:** [Describe the flow and key logic within the embed]",
			"**Key APIs/Concepts:**",
			"- `[API/Concept 1]`: [Explanation]",
			"- `[API/Concept 2]`: [Explanation]",
			"",
			"[Provide detailed explanation of the embedded code, aiming for 200+ words if code > 5 lines]",
			"$0",
			"-->"
		],
		"description": "Creates a slide structure for embedded Expo Snack or CodeSandbox examples (> 25 lines)."
	},
	"Mermaid Diagram Slide": {
		"prefix": "marp-diagram",
		"body": [
			"<!-- --- -->",
			"",
			"## ${1:Diagram Title}",
			"",
			"${2:Brief introductory sentence describing the diagram.}",
			"",
			"```mermaid",
			"${3:graph TD;}",
			"    A[Start] --> B(Process);",
			"    B --> C{Decision};",
			"    C -->|Yes| D[Result 1];",
			"    C -->|No| E[Result 2];",
			"```",
			"",
			"<!-- Presenter Notes:",
			"**Diagram Explanation:** [Explain what the diagram illustrates, the meaning of shapes/arrows, and the overall flow/relationship shown.]",
			"$0",
			"-->"
		],
		"description": "Creates a slide structure for Mermaid diagrams."
	},
	"Table Slide": {
		"prefix": "marp-table",
		"body": [
			"<!-- --- -->",
			"",
			"## ${1:Table Title}",
			"",
			"${2:Brief introductory sentence describing the table.}",
			"",
			"| Header 1 | Header 2 | Header 3 |",
			"| :------- | :------: | -------: |",
			"| Align-L  | Center   | Align-R  |",
			"| Data 1   | Data 2   | Data 3   |",
			"",
			"<!-- Presenter Notes:",
			"**Table Explanation:** [Explain the purpose of the table, what data it compares/lists, and highlight key takeaways or comparisons.]",
			"$0",
			"-->"
		],
		"description": "Creates a slide structure for Markdown tables."
	},
	"Official Documentation Link": {
		"prefix": "marp-link-docs",
		"body": [
			"[${1:Descriptive Text}](${2:URL} \"Link to Official Documentation\")$0"
		],
		"description": "Inserts a formatted link, emphasizing official documentation source."
	},
	"Presenter Notes Block": {
		"prefix": "marp-notes",
		"body": [
			"<!-- Presenter Notes:",
			"$0",
			"-->"
		],
		"description": "Inserts an empty presenter notes comment block."
	}
}
